<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sm</AssemblyName>
    <RootNamespace>SourceManager</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>13.0</LangVersion>
    <Version>1.0.0</Version>
    <Authors>SourceManager Team</Authors>
    <Description>SourceManager - A next-generation version control system (CLI over LibSM).</Description>
    <PackageId>SourceManager</PackageId>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The engine lives in LibSM; the CLI is the porcelain/plumbing surface on top of it. -->
  <ItemGroup>
    <ProjectReference Include="LibSM\LibSM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LibSM\**" />
    <Compile Remove="samples\**" />
    <Compile Remove="temp_test\**" />
    <Compile Remove="_test_compile\**" />
    <None Remove="LibSM\**" />
    <None Remove="samples\**" />
    <None Remove="temp_test\**" />
    <None Remove="_test_compile\**" />
  </ItemGroup>

</Project>
